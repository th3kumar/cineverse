# Copy to .env.local. With nothing set, everything runs on offline mock providers.

# ─── AI: one generic set of variables for any vendor ─────────────────────────
# gemini | openai | anthropic | groq | openrouter | ollama | custom | mock
AI_PROVIDER=mock
AI_API_KEY=
# Defaults to gemini-3.5-flash for gemini; required for every other provider.
AI_MODEL=
# Only needed for AI_PROVIDER=custom (any OpenAI-compatible /v1 endpoint) or to override a preset.
AI_BASE_URL=
# Set false if an OpenAI-compatible server rejects response_format.
AI_NATIVE_JSON=true

# Examples:
#   AI_PROVIDER=gemini      AI_API_KEY=<AI Studio key>
#   AI_PROVIDER=groq        AI_API_KEY=<groq key>    AI_MODEL=<model id>
#   AI_PROVIDER=openrouter  AI_API_KEY=<key>         AI_MODEL=<vendor/model>
#   AI_PROVIDER=ollama      AI_MODEL=llama3.1        (local, no key)
#   AI_PROVIDER=anthropic   AI_API_KEY=<key>         AI_MODEL=<claude model id>

# ─── Cineverse catalogue ─────────────────────────────────────────────────────
CINE_REGION=IN
# tmdb | mock
CINE_METADATA=mock
# Comma list, merged: tmdb, watchmode, mock
CINE_AVAILABILITY=mock
# Comma list, tried in order: archive, youtube
CINE_PLAYBACK=archive,youtube
# Defaults to data/allowlist.json (data/allowlist.mock.json in mock mode)
CINE_ALLOWLIST=
CINE_RECOMMENDATION_COUNT=5

# ─── Vendor keys (only for providers you enabled above) ──────────────────────
# TMDB: v4 "API Read Access Token" (preferred) or v3 key
TMDB_API_KEY=
WATCHMODE_API_KEY=
YOUTUBE_API_KEY=
# true = search official channels (100 quota units/search)
YOUTUBE_SEARCH=false

# ─── Your own API key for external clients (e.g. the Android app) ───────────
# If set, /api/* requires header:  x-cineverse-key: <value>
CINEVERSE_API_KEY=
